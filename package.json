{
  "name": "@keshavv/cli",
  "version": "0.1.0",
  "description": "Interactive CLI to generate production-ready TypeScript backend projects (Express/Fastify, Drizzle/Prisma, PostgreSQL)",
  "type": "module",
  "bin": {
    "devium": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsup",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "backend",
    "typescript",
    "scaffold",
    "generator",
    "cli",
    "express",
    "fastify",
    "drizzle",
    "prisma",
    "postgresql"
  ],
  "author": "Devium Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keshav7x/devium-app.git"
  },
  "homepage": "https://github.com/keshav7x/devium-app#readme",
  "bugs": {
    "url": "https://github.com/keshav7x/devium-app/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3"
  }
}
